<div class="cv-map">
  {% for content in entry.contents %}
    <div class="cv-map-row">
      <div class="cv-map-name">{{ content.name }}</div>
      {% if content.value %}
        <div class="cv-map-value">{{ content.value }}</div>
      {% endif %}
      {% if content.links %}
        <div class="cv-map-links container-pdf">
          {% for item in content.links %}
            {% if item.link %}
              <div class="container-link-button">
                {% if item.name %}
                  <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="btncv z-depth-0">{{ item.name }}</a>
                {% else %}
                  <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="btncv z-depth-0">doc</a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
